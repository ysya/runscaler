# Linux amd64 pilot only. Copy to .env, which Git ignores, and fill every blank.
# Select a private interface reachable from actual runner and BuildKit networks.
# Never use 0.0.0.0 or :: as a host binding, or localhost as a job endpoint.
CACHE_BIND_IP=
CACHE_PORT=3000
# Absolute http(s) URL with trailing slash, e.g. http://<private-host-ip>:3000/
CACHE_ADVERTISE_URL=
# Required positive integer bytes. Choose this from the host's disk capacity.
CACHE_MAX_SIZE_BYTES=
# Generate/store a private operator key. Never pass it to jobs or commit .env.
CACHE_MANAGEMENT_KEY=
